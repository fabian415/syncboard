generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  RD
}

enum ReportStatus {
  DRAFTING
  SUBMITTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports       Report[]
  memberReports MemberReport[]
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  tag         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reports         Report[]
  combinedReports CombinedReport[]
}

model Report {
  id           String       @id @default(uuid())
  projectId    String
  userId       String
  reportDate   DateTime     @db.Date
  status       ReportStatus @default(DRAFTING)
  markdownPath String
  htmlPath     String?
  submittedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId, reportDate])
}

model MemberReport {
  id           String   @id @default(uuid())
  userId       String
  periodStart  DateTime @db.Date
  markdownPath String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, periodStart])
}

model MeetingStatusReport {
  id           String   @id @default(uuid())
  meetingDate  DateTime @unique @db.Date
  markdownPath String
  htmlPath     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MeetingStatusSection {
  id           String   @id @default(uuid())
  meetingDate  DateTime @db.Date
  sectionKey   String
  markdownPath String
  htmlPath     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([meetingDate, sectionKey])
}

model CombinedReport {
  id          String   @id @default(uuid())
  projectId   String
  reportDate  DateTime @db.Date
  htmlPath    String
  generatedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, reportDate])
}

enum DeepDiveAssetType {
  HTML
  IMAGE
  VIDEO
  PPTX
}

enum DeepDiveAssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model DeepDiveAsset {
  id           String              @id @default(uuid())
  meetingDate  DateTime            @db.Date
  assetType    DeepDiveAssetType
  status       DeepDiveAssetStatus @default(UPLOADING)
  originalName String
  filePath     String
  mimeType     String?
  sizeBytes    Int?
  slideCount   Int?
  errorMessage String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([meetingDate, assetType])
}
