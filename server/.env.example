# Deep Dive PPTX conversion sidecar (docker-compose.yml `unoserver` service).
# For local (non-Docker) dev, run `docker compose up -d unoserver` and point
# these at its published host port (see docker-compose.yml for the mapping).
UNOSERVER_HOST=localhost
UNOSERVER_PORT=2004
